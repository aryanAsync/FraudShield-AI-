# FraudShield AI - ML Service Environment Configuration

# Service Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/fraudshield
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET_KEY_FOR_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Data & Model Paths
DATASET_PATH=data/raw/creditcard.csv
MODEL_ARTIFACT_PATH=artifacts/fraud_model_v1.joblib
MODEL_VERSION=fraud-model-v1

# Inference Settings
# Leave DECISION_THRESHOLD_OVERRIDE empty or unset to use the threshold optimized during training
DECISION_THRESHOLD_OVERRIDE=
MAX_BATCH_SIZE=500
ENABLE_SHAP_EXPLANATIONS=true
